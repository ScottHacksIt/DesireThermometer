# ==========================================
# Dependencies & Package Managers
# ==========================================
/vendor/
/node_modules/
npm-debug.log
yarn-error.log

# ==========================================
# Environment & Sensitive Data
# ==========================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing the template file
!.env.example

# ==========================================
# Application Logs, Cache, & Storage
# ==========================================
*.log
/storage/*.log
/var/log/
/var/cache/
/var/tmp/
.phpunit.result.cache

# ==========================================
# IDE & System Files (Optional/Recommended)
# ==========================================
# JetBrains / PHPStorm
/.idea/

# VS Code
/.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
